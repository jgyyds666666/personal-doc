# 图形化部署推荐：填写明文，并由后端首次登录时转换一次、缓存在进程内存。
ADMIN_PASSWORD=
ADMIN_PASSWORD_MODE=plain

# 如需配置哈希：把生成的 scrypt$... 仍填入 ADMIN_PASSWORD，并将模式改为 hash。
# pnpm auth:hash -- "至少6位的密码"
# ADMIN_PASSWORD=scrypt$...
# ADMIN_PASSWORD_MODE=hash

# 至少 32 个随机字符；生产环境必须单独生成，禁止提交到 Git。
SESSION_SECRET=

# 允许的请求来源白名单（逗号分隔，可带协议/端口），用于反向代理无法正确透传
# Host/X-Forwarded-Host 的部署网关场景。例：ALLOWED_ORIGINS=https://example.com,https://example.cn
ALLOWED_ORIGINS=

# 当前 Coze S3Storage 兼容配置。迁移存储提供商时可使用通用别名。
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=cn-beijing
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
