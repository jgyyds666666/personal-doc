# 管理员密码。以下两种方式二选一：
#   方式A（推荐）：用 `pnpm auth:hash -- "至少6位的密码"` 生成哈希填入 ADMIN_PASSWORD_HASH
#   方式B（易用）：直接往 ADMIN_PASSWORD 填明文密码，系统运行时自动转换为哈希校验。
#     ※ 生产环境出于安全建议优先用方式A；方式B便于快速验证。
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# 至少 32 个随机字符；生产环境必须单独生成，禁止提交到 Git。
SESSION_SECRET=

# 允许的请求来源白名单（逗号分隔，可带协议/端口），用于反向代理无法正确透传
# Host/X-Forwarded-Host 的部署网关场景。例：ALLOWED_ORIGINS=https://example.com,https://example.cn
ALLOWED_ORIGINS=

# 当前 Coze S3Storage 兼容配置。迁移存储提供商时可使用通用别名。
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=cn-beijing
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
