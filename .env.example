# 使用 `pnpm auth:hash -- "至少12位的密码"` 生成，禁止填写明文密码。
ADMIN_PASSWORD_HASH=

# 至少 32 个随机字符；生产环境必须单独生成，禁止提交到 Git。
SESSION_SECRET=

# 当前 Coze S3Storage 兼容配置。迁移存储提供商时可使用通用别名。
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=cn-beijing
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
